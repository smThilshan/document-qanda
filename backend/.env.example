# Copy this file to .env and fill in real values. Never commit .env itself.

OPENAI_API_KEY=sk-your-openai-api-key-here
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-service-or-anon-key-here

# Optional — comma-separated list of origins allowed to call this API from
# a browser. Defaults to http://localhost:5173 (local frontend dev) if
# unset. In production, set this to your deployed frontend's exact URL,
# e.g. https://your-app.vercel.app
ALLOWED_ORIGINS=http://localhost:5173
